# Cache-Me-Outside with the BSD-licensed Valkey project modules (plan items 4, 5, 69, 70).
# Build:  docker build -f Dockerfile.modules --build-arg BASE=cache-me-outside:local -t cache-me-outside:modules .
# Run with CMO_MODULES="json bloom search".
# Tags were the latest releases on 2026-11-01; bump them deliberately.
ARG BASE=cache-me-outside:local
ARG JSON_TAG=1.0.3
ARG BLOOM_TAG=1.0.1
ARG SEARCH_TAG=1.3.0-rc2

FROM debian:bookworm-slim AS json
ARG JSON_TAG
RUN apt-get update && apt-get install -y --no-install-recommends build-essential cmake git ca-certificates && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 -b "${JSON_TAG}" https://github.com/valkey-io/valkey-json /m \
    && cd /m && ./build.sh && find /m -name 'libjson.so' -exec cp {} /libjson.so \;

FROM rust:1-bookworm AS bloom
ARG BLOOM_TAG
RUN apt-get update && apt-get install -y --no-install-recommends clang && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 -b "${BLOOM_TAG}" https://github.com/valkey-io/valkey-bloom /m \
    && cd /m && cargo build --release && cp target/release/libvalkey_bloom.so /libbloom.so

FROM debian:bookworm-slim AS search
ARG SEARCH_TAG
RUN apt-get update && apt-get install -y --no-install-recommends build-essential cmake git ca-certificates ninja-build python3 && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 -b "${SEARCH_TAG}" https://github.com/valkey-io/valkey-search /m \
    && cd /m && ./build.sh --release && find /m -name 'libsearch.so' -exec cp {} /libsearch.so \;

FROM ${BASE}
COPY --from=json /libjson.so /usr/local/lib/cmo-modules/libjson.so
COPY --from=bloom /libbloom.so /usr/local/lib/cmo-modules/libbloom.so
COPY --from=search /libsearch.so /usr/local/lib/cmo-modules/libsearch.so
