{
  "uid": "cmo-overview",
  "title": "Cache Me Outside: overview",
  "schemaVersion": 39,
  "tags": [
    "cache-me-outside"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Ops per second",
      "datasource": {
        "type": "prometheus",
        "uid": "cmo-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cmo-prom"
          },
          "expr": "sum by (db) (cmo_ops_rate)"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Hit ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "cmo-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cmo-prom"
          },
          "expr": "sum(rate(cmo_keyspace_hits_total[5m])) / clamp_min(sum(rate(cmo_keyspace_hits_total[5m])) + sum(rate(cmo_keyspace_misses_total[5m])), 1)"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Hits vs misses",
      "datasource": {
        "type": "prometheus",
        "uid": "cmo-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cmo-prom"
          },
          "expr": "sum by (db) (rate(cmo_keyspace_hits_total[5m])) or sum by (db) (rate(cmo_keyspace_misses_total[5m]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Memory used",
      "datasource": {
        "type": "prometheus",
        "uid": "cmo-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cmo-prom"
          },
          "expr": "sum by (db) (cmo_memory_used)"
        }
      ]
    },
    {
      "id": 5,
      "type": "gauge",
      "title": "Memory used / max",
      "datasource": {
        "type": "prometheus",
        "uid": "cmo-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cmo-prom"
          },
          "expr": "sum by (db) (cmo_memory_used) / clamp_min(sum by (db) (cmo_memory_max), 1)"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Fragmentation",
      "datasource": {
        "type": "prometheus",
        "uid": "cmo-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cmo-prom"
          },
          "expr": "max by (db) (cmo_memory_fragmentation)"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Clients connected",
      "datasource": {
        "type": "prometheus",
        "uid": "cmo-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cmo-prom"
          },
          "expr": "sum by (db) (cmo_clients_connected)"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Rejected connections",
      "datasource": {
        "type": "prometheus",
        "uid": "cmo-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cmo-prom"
          },
          "expr": "sum by (db) (rate(cmo_connections_rejected_total[5m]))"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Evicted keys",
      "datasource": {
        "type": "prometheus",
        "uid": "cmo-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cmo-prom"
          },
          "expr": "sum by (db) (rate(cmo_keys_evicted_total[5m]))"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Expired keys",
      "datasource": {
        "type": "prometheus",
        "uid": "cmo-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cmo-prom"
          },
          "expr": "sum by (db) (rate(cmo_keys_expired_total[5m]))"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Commands",
      "datasource": {
        "type": "prometheus",
        "uid": "cmo-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cmo-prom"
          },
          "expr": "sum by (db) (rate(cmo_commands_total[5m]))"
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Replicas connected",
      "datasource": {
        "type": "prometheus",
        "uid": "cmo-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cmo-prom"
          },
          "expr": "min by (db) (cmo_replicas_connected)"
        }
      ]
    }
  ],
  "templating": {
    "list": []
  }
}
