# Copy to deploy/.env (mode 0600) and replace both passwords.
# Never commit deploy/.env. Passwords must be at least 16 characters and may
# contain only letters, digits, and these characters: _ . / + = @ -
#
#   umask 077
#   cp cache-me-outside.env.example .env
#   chmod 600 .env

CMO_ADMIN_USER=admin
CMO_ADMIN_PASSWORD=replace-with-a-long-random-admin-secret
CMO_APP_USER=app
CMO_APP_PASSWORD=replace-with-a-long-random-app-secret

# Host address and port published by Docker. 127.0.0.1 keeps the port on
# localhost. For a LAN address, set this to that interface's IP.
# 0.0.0.0, *, and :: are rejected by deploy/up.sh.
CMO_BIND_ADDRESS=127.0.0.1
CMO_HOST_PORT=6379

# Port inside the container. Leave this at 6379 unless you change the image.
CMO_PORT=6379

# Cache size and eviction. allkeys-lru matches a cache workload.
CMO_MAXMEMORY=256mb
CMO_MAXMEMORY_POLICY=allkeys-lru

# Container memory limit. Keep this at least twice CMO_MAXMEMORY so a forked
# AOF rewrite or RDB snapshot has copy-on-write headroom. Docker's `m` is
# 1024-based, same as Valkey's `mb`.
CMO_CONTAINER_MEMORY=512m

# CPU cap for the container, in CPUs (compose `cpus`). 1.0 is one core.
CMO_CPUS=1.0

# I/O threads. 1 keeps reads and writes on the main thread. This Valkey build
# threads both reads and writes when the value is greater than 1. The old
# io-threads-do-reads setting has no effect and is not passed through.
# Leave this at 1 until one core is saturated, and keep it below the CPU cap.
CMO_IO_THREADS=1

# Sentinel topology (./up.sh sentinel). Ignored by standalone.
# Replicas are in addition to the primary. Use an odd sentinel count.
CMO_REPLICAS=2
CMO_SENTINELS=3
CMO_SENTINEL_PORT=26379
CMO_SENTINEL_DOWN_AFTER_MS=5000
CMO_SENTINEL_FAILOVER_TIMEOUT=60000
CMO_SENTINEL_MEMORY=128m
CMO_SENTINEL_CPUS=0.25

# Cluster topology (./up.sh cluster). At least 3 primaries.
# CMO_CLUSTER_REPLICAS is replicas per primary, not the total.
CMO_CLUSTER_PRIMARIES=3
CMO_CLUSTER_REPLICAS=1
CMO_CLUSTER_NODE_TIMEOUT=5000
