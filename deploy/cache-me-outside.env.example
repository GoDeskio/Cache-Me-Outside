# Copy to deploy/.env (mode 0600) and replace both passwords.
# Never commit deploy/.env. Passwords must be at least 16 characters and may
# contain only letters, digits, and these characters: _ . / + = @ -
#
#   umask 077
#   cp cache-me-outside.env.example .env
#   chmod 600 .env
#
# To keep this file outside the repo, export CMO_ENV_FILE to its absolute
# path before ./up.sh, ./smoke.sh, ./bench.sh, or ./scale-memory.sh.
# Compose loads that path with required: false.

CMO_ADMIN_USER=admin
CMO_ADMIN_PASSWORD=replace-with-a-long-random-admin-secret
CMO_APP_USER=app
CMO_APP_PASSWORD=replace-with-a-long-random-app-secret

# Host address and port published by Docker. 127.0.0.1 keeps the port on
# localhost. For a LAN address, set this to that interface's IP.
# 0.0.0.0, *, and :: are rejected by deploy/up.sh.
CMO_BIND_ADDRESS=127.0.0.1
CMO_HOST_PORT=6379

# Port inside the container. Leave this at 6379 unless you change the image.
CMO_PORT=6379

# Cache size and eviction. allkeys-lru matches a cache workload.
CMO_MAXMEMORY=256mb
CMO_MAXMEMORY_POLICY=allkeys-lru

# Container memory limit. Keep this at least twice CMO_MAXMEMORY so a forked
# AOF rewrite or RDB snapshot has copy-on-write headroom. Docker's `m` is
# 1024-based, same as Valkey's `mb`.
CMO_CONTAINER_MEMORY=512m

# CPU cap for the container, in CPUs (compose `cpus`). 1.0 is one core.
CMO_CPUS=1.0

# I/O threads. 1 keeps reads and writes on the main thread. This Valkey build
# threads both reads and writes when the value is greater than 1. The old
# io-threads-do-reads setting has no effect and is not passed through.
# Leave this at 1 until one core is saturated, and keep it below the CPU cap.
CMO_IO_THREADS=1

# Sentinel topology (./up.sh sentinel). Ignored by standalone.
# Replicas are in addition to the primary. Use an odd sentinel count.
CMO_REPLICAS=2
CMO_SENTINELS=3
CMO_SENTINEL_PORT=26379
CMO_SENTINEL_DOWN_AFTER_MS=5000
CMO_SENTINEL_FAILOVER_TIMEOUT=60000
CMO_SENTINEL_MEMORY=128m
# A cap of 0.25 or less can pause Sentinel long enough that it enters TILT
# and waits about 30 seconds before it will fail over. 1.0 avoids that.
CMO_SENTINEL_CPUS=1.0

# Cluster topology (./up.sh cluster). At least 3 primaries.
# CMO_CLUSTER_REPLICAS is replicas per primary, not the total.
CMO_CLUSTER_PRIMARIES=3
CMO_CLUSTER_REPLICAS=1
CMO_CLUSTER_NODE_TIMEOUT=5000

# Optional. DNS name on proxy-net. Do not set this to redis or valkey.
# CMO_NETWORK_ALIAS=cache-me-outside

# Compose project, Docker network, and container/volume name prefix.
# Leave these unset for a normal deployment. The defaults are all
# cache-me-outside, so the standalone container stays cache-me-outside and
# its volume stays cache-me-outside-data. Sentinel and cluster members are
# cache-me-outside-primary, cache-me-outside-replica-N, cache-me-outside-sentinel-N,
# and cache-me-outside-cluster-N.
# Test scripts force cmo-test unless you pass --i-know. Do not set these to
# cache-me-outside in a file that those scripts source.
# CMO_PROJECT=my-cache
# CMO_NETWORK=my-cache
# CMO_NAME_PREFIX=my-cache
# CMO_PRODUCTION_PROJECT=cache-me-outside

# Optional IPv4 subnet for the Compose network this project creates.
# Leave it unset to let Docker pick a pool. Set it when the host's default
# pools are exhausted: Docker may then allocate 192.168.0.0/20 (or another
# 192.168 range) that overlaps the LAN, and containers lose the route to it.
# Use a free range. 203.0.113.0/24 is documentation space (TEST-NET-3), not
# an address to copy onto a real LAN.
# CMO_SUBNET=203.0.113.0/24

# Optional users. Unset means replication, Sentinel, and cluster tooling all
# authenticate as admin. Each name and password must differ from admin and app.
# The cluster bus is not an ACL user. CMO_CLUSTER_USER is only the account
# valkey-cli --cluster uses for CLUSTER admin commands and MIGRATE.
# CMO_REPL_USER=replicator
# CMO_REPL_PASSWORD=replace-with-a-long-random-repl-secret
# CMO_SENTINEL_USER=sentinel
# CMO_SENTINEL_PASSWORD=replace-with-a-long-random-sentinel-secret
# CMO_CLUSTER_USER=cluster
# CMO_CLUSTER_PASSWORD=replace-with-a-long-random-cluster-secret

# Optional. Benchmark report directory. Default is deploy/results.
# CMO_BENCH_OUT_DIR=results

# Optional. Benchmark Cache-Me-Outside as admin so valkey-benchmark can CONFIG.
# The default user is app, and the CONFIG warning is omitted from the report.
# CMO_BENCH_USER=app
