# Cache-Me-Outside environment for a VM or bare-metal host.
# systemd reads this file. Replace both passwords before enabling the unit.
# Passwords must differ, be at least 16 characters, and use only letters,
# digits, and _ . / + = @ -. The server refuses the placeholders below.
#
# The process binds 127.0.0.1 and, when it differs, CMO_BIND_ADDRESS.
# 0.0.0.0, ::, and * are refused. Do not put a house LAN address in git.

CMO_ADMIN_USER=admin
CMO_ADMIN_PASSWORD=replace-with-a-long-random-admin-secret
CMO_APP_USER=app
CMO_APP_PASSWORD=replace-with-a-long-random-app-secret

# standalone, replica, or cluster. Sentinel uses the sentinel unit and
# /etc/cache-me-outside/sentinel.environment instead of this role.
CMO_ROLE=standalone
CMO_CLUSTER_ENABLED=no

# One reachable address. 127.0.0.1 is correct for a node with local clients only.
CMO_BIND_ADDRESS=127.0.0.1
CMO_PORT=6379

CMO_MAXMEMORY=256mb
CMO_MAXMEMORY_POLICY=allkeys-lru
CMO_IO_THREADS=1

# Replica: set CMO_ROLE=replica and the primary's reachable address.
# CMO_PRIMARY_HOST=
# CMO_PRIMARY_PORT=6379

# Cluster member. Announce the address other VMs, containers, and pods can route to.
# CMO_ROLE=cluster
# CMO_CLUSTER_ENABLED=yes
# CMO_ANNOUNCE_IP=203.0.113.10
# CMO_ANNOUNCE_PORT=6379
# CMO_ANNOUNCE_BUS_PORT=16379
# CMO_CLUSTER_NODE_TIMEOUT=5000
# Join an existing cluster (cmo-join-cluster). Do not set this on the nodes
# that cmo-form-cluster creates together.
# CMO_CLUSTER_SEED=203.0.113.10:6379
# CMO_CLUSTER_JOIN_AS=primary
# CMO_CLUSTER_PRIMARY_ID=
