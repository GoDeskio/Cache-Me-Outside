[Unit]
Description=Cache-Me-Outside Sentinel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=valkey
Group=valkey
Environment=CMO_RUNTIME_DIR=/run/cache-me-outside-sentinel
EnvironmentFile=/etc/cache-me-outside/sentinel.environment
RuntimeDirectory=cache-me-outside-sentinel
RuntimeDirectoryMode=0750
ExecStart=/usr/lib/cache-me-outside/cmo-run
ExecStop=/usr/lib/cache-me-outside/cmo-shutdown
TimeoutStopSec=15
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
